---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

const warning2 = t('compliance.warning2', { returnObjects: true }) as {
  before: string;
  strong1: string;
  mid: string;
  strong2: string;
  after: string;
};
const tooling = t('compliance.tooling', { returnObjects: true }) as {
  title: string;
  framework: string;
  support: string;
  rows: { standard: string; support: string }[];
};
---
<DocLayout title={t('compliance.meta.title')} description={t('compliance.meta.description')}>
<h1 class="text-3xl font-bold mb-6" data-i18n="compliance.title">{t('compliance.title')}</h1>
<div class="rounded-xl bg-danger-soft/10 border-2 border-danger-soft p-6 mb-8">
<p class="text-base font-bold text-danger-text mb-2" data-i18n="compliance.warning1">{t('compliance.warning1')}</p>
<p class="text-sm text-danger-text"><span data-i18n="compliance.warning2.before">{warning2.before}</span><strong data-i18n="compliance.warning2.strong1">{warning2.strong1}</strong><span data-i18n="compliance.warning2.mid">{warning2.mid}</span><strong data-i18n="compliance.warning2.strong2">{warning2.strong2}</strong><span data-i18n="compliance.warning2.after">{warning2.after}</span></p></div>

<p class="mb-6 text-neutral-600" data-i18n="compliance.lead">{t('compliance.lead')}</p>

<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="compliance.tooling.title">{tooling.title}</h2>
<table class="w-full text-sm mb-6 border-collapse"><thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2 px-2" data-i18n="compliance.tooling.framework">{tooling.framework}</th><th class="text-left font-medium py-2 px-2" data-i18n="compliance.tooling.support">{tooling.support}</th></tr></thead><tbody>
{tooling.rows.map((row, index) => <tr class="border-b border-neutral-100"><td class="py-2 px-2" data-i18n={`compliance.tooling.rows.${index}.standard`}>{row.standard}</td><td class="py-2 px-2" data-i18n={`compliance.tooling.rows.${index}.support`}>{row.support}</td></tr>)}
</tbody></table>

<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="compliance.features.title">{t('compliance.features.title')}</h2>
<h3 class="text-lg font-bold mb-2 mt-6" data-i18n="compliance.hash.title">{t('compliance.hash.title')}</h3>
<p class="mb-4 text-neutral-600" data-i18n="compliance.hash.body">{t('compliance.hash.body')}</p>
<h3 class="text-lg font-bold mb-2 mt-6" data-i18n="compliance.retention.title">{t('compliance.retention.title')}</h3>
<p class="mb-4 text-neutral-600" data-i18n="compliance.retention.body">{t('compliance.retention.body')}</p>
<h3 class="text-lg font-bold mb-2 mt-6" data-i18n="compliance.classification.title">{t('compliance.classification.title')}</h3>
<p class="mb-4 text-neutral-600" data-i18n="compliance.classification.body">{t('compliance.classification.body')}</p>
</DocLayout>
