---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

const links = t('notFound.links', { returnObjects: true }) as { label: string; href: string; description: string }[];
---
<DocLayout title={t('notFound.meta.title')} description={t('notFound.meta.description')}>
  <span class="brand-kicker" data-i18n="notFound.kicker">{t('notFound.kicker')}</span>
  <h1 class="mt-5" data-i18n="notFound.title">{t('notFound.title')}</h1>
  <p data-i18n="notFound.lead">
    {t('notFound.lead')}
  </p>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {links.map((link, index) => (
      <a href={link.href} class="brand-card block px-6 py-5 no-underline">
        <div class="text-lg font-semibold text-primary-900" data-i18n={`notFound.links.${index}.label`}>{link.label}</div>
        <p class="mt-2 text-sm leading-7 text-neutral-600" data-i18n={`notFound.links.${index}.description`}>{link.description}</p>
      </a>
    ))}
  </div>
</DocLayout>
