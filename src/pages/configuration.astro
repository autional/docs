---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

// 结构列（变量名 / 是否必填 / 默认值）语言无关，随页留存；说明列经 i18n 键化（同索引对齐，长度在构建期断言）。
const vars = [
  { name: 'JWT_SECRET', required: true, default: '—' },
  { name: 'PASSWORD_PEPPER', required: true, default: '—' },
  { name: 'INTERNAL_API_KEY', required: true, default: '—' },
  { name: 'POSTGRES_HOST', required: true, default: 'localhost' },
  { name: 'POSTGRES_PORT', required: false, default: '5432' },
  { name: 'POSTGRES_USER', required: true, default: 'authuser' },
  { name: 'POSTGRES_PASSWORD', required: true, default: 'authpassword' },
  { name: 'REDIS_HOST', required: false, default: 'localhost' },
  { name: 'REDIS_PORT', required: false, default: '6379' },
  { name: 'REDIS_PASSWORD', required: false, default: '' },
  { name: 'RABBITMQ_HOST', required: false, default: 'localhost' },
  { name: 'RABBITMQ_PORT', required: false, default: '5672' },
  { name: 'RABBITMQ_USER', required: false, default: 'admin' },
  { name: 'RABBITMQ_PASSWORD', required: false, default: 'adminpassword' },
  { name: 'APP_ENV', required: false, default: 'development' },
  { name: 'AUDIT_MONGODB_HOST', required: false, default: 'localhost' },
  { name: 'AUDIT_MONGODB_PORT', required: false, default: '27017' },
  { name: 'MINIO_ENDPOINT', required: false, default: '—' },
];
const descs = t('configuration.vars', { returnObjects: true }) as string[];
if (descs.length !== vars.length) {
  throw new Error(`[i18n] configuration.vars 长度与页面结构不符：${descs.length} ≠ ${vars.length}`);
}
const files = t('configuration.files', { returnObjects: true }) as { title: string; lead: { before: string; mid: string; after: string } };
---
<DocLayout title={t('configuration.meta.title')} description={t('configuration.meta.description')}>
<h1 class="text-3xl font-bold mb-6" data-i18n="configuration.title">{t('configuration.title')}</h1>
<p class="mb-6 text-neutral-600"><span data-i18n="configuration.lead.before">{t('configuration.lead.before')}</span><code class="bg-neutral-100 dark:bg-surface px-1 rounded-xs">configs/service/*.yaml</code><span data-i18n="configuration.lead.mid">{t('configuration.lead.mid')}</span><code class="bg-neutral-100 dark:bg-surface px-1 rounded-xs">.env</code><span data-i18n="configuration.lead.after">{t('configuration.lead.after')}</span></p>
<table class="w-full text-sm border-collapse"><thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2 px-2" data-i18n="configuration.table.variable">{t('configuration.table.variable')}</th><th class="text-left font-medium py-2 px-2" data-i18n="configuration.table.description">{t('configuration.table.description')}</th><th class="text-left font-medium py-2 px-2" data-i18n="configuration.table.required">{t('configuration.table.required')}</th><th class="text-left font-medium py-2 px-2" data-i18n="configuration.table.default">{t('configuration.table.default')}</th></tr></thead><tbody>
{vars.map((v, index) => <tr class="border-b border-neutral-100"><td class="py-2 px-2 font-mono text-xs">{v.name}</td><td class="py-2 px-2" data-i18n={`configuration.vars.${index}`}>{descs[index]}</td><td class="py-2 px-2">{v.required ? <span class="text-success-text" data-i18n="common.yes">{t('common.yes')}</span> : <span class="text-[var(--color-text-muted)]" data-i18n="common.no">{t('common.no')}</span>}</td><td class="py-2 px-2 font-mono text-xs text-neutral-500">{v.default}</td></tr>)}
</tbody></table>
<h2 class="text-xl font-bold mt-8 mb-3" data-i18n="configuration.files.title">{files.title}</h2>
<p class="mb-4 text-neutral-600"><span data-i18n="configuration.files.lead.before">{files.lead.before}</span><code class="bg-neutral-100 dark:bg-surface px-1 rounded-xs">configs/service/&#123;name&#125;.yaml</code><span data-i18n="configuration.files.lead.mid">{files.lead.mid}</span><code class="bg-neutral-100 dark:bg-surface px-1 rounded-xs">configs/service/&#123;name&#125;.gorm.yaml</code><span data-i18n="configuration.files.lead.after">{files.lead.after}</span></p>
<pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6"># configs/service/ directory contains:
configs/service/identity-service.yaml
configs/service/identity-service.gorm.yaml
configs/service/mfa-service.yaml
...</pre>
</DocLayout>
