---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

const isolation = t('multiTenant.isolation', { returnObjects: true }) as {
  title: string;
  layer: string;
  enforcement: string;
  rows: { name: string; enforcement: string }[];
};
const config = t('multiTenant.config', { returnObjects: true }) as {
  title: string;
  lead: string;
  items: { label: string; body: string }[];
};
const nhi = t('multiTenant.nhi', { returnObjects: true }) as {
  title: string;
  lead: string;
  items: { label: string; states: string }[];
};
---
<DocLayout title={t('multiTenant.meta.title')} description={t('multiTenant.meta.description')}>
<h1 class="text-3xl font-bold mb-6" data-i18n="multiTenant.title">{t('multiTenant.title')}</h1>
<p class="mb-6 text-neutral-600" data-i18n="multiTenant.lead">{t('multiTenant.lead')}</p>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="multiTenant.isolation.title">{isolation.title}</h2>
<table class="w-full text-sm mb-6 border-collapse"><thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2 px-2" data-i18n="multiTenant.isolation.layer">{isolation.layer}</th><th class="text-left font-medium py-2 px-2" data-i18n="multiTenant.isolation.enforcement">{isolation.enforcement}</th></tr></thead><tbody>
{isolation.rows.map((row, index) => <tr class="border-b border-neutral-100"><td class="py-2 px-2"><strong>{row.name}</strong></td><td class="py-2 px-2" data-i18n={`multiTenant.isolation.rows.${index}.enforcement`}>{row.enforcement}</td></tr>)}
</tbody></table>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="multiTenant.config.title">{config.title}</h2>
<p class="mb-4 text-neutral-600" data-i18n="multiTenant.config.lead">{config.lead}</p>
<ul class="list-disc pl-6 space-y-1 text-sm text-neutral-600 mb-6">
{config.items.map((item, index) => <li><strong data-i18n={`multiTenant.config.items.${index}.label`}>{item.label}</strong><span data-i18n={`multiTenant.config.items.${index}.body`}>{item.body}</span></li>)}
</ul>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="multiTenant.members.title">{t('multiTenant.members.title')}</h2>
<p class="mb-4 text-neutral-600" data-i18n="multiTenant.members.lead">{t('multiTenant.members.lead')}</p>
<pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6">Admin invites → User receives email → User accepts → Role assigned</pre>
<p class="mb-4 text-neutral-600" data-i18n="multiTenant.members.body">{t('multiTenant.members.body')}</p>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="multiTenant.nhi.title">{nhi.title}</h2>
<p class="mb-4 text-neutral-600" data-i18n="multiTenant.nhi.lead">{nhi.lead}</p>
<ul class="list-disc pl-6 space-y-1 text-sm text-neutral-600 mb-6">
{nhi.items.map((item, index) => <li><strong data-i18n={`multiTenant.nhi.items.${index}.label`}>{item.label}</strong><span data-i18n={`multiTenant.nhi.items.${index}.states`}>{item.states}</span></li>)}
</ul>
</DocLayout>
