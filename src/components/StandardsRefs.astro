---
export interface StandardsRefItem {
  label: string;
  href: string;
}
export interface Props {
  keyPrefix: string;
  title: string;
  lead?: string;
  items: StandardsRefItem[];
}
const { keyPrefix, title, lead, items } = Astro.props;
---
<section class="mt-10 border-t border-neutral-200 pt-6">
  <h2 class="text-xl font-bold mb-3" data-i18n={`${keyPrefix}.title`}>{title}</h2>
  {lead && <p class="mb-4 text-sm text-neutral-600" data-i18n={`${keyPrefix}.lead`}>{lead}</p>}
  <ul class="grid grid-cols-1 gap-x-8 gap-y-2 text-sm text-neutral-600 sm:grid-cols-2">
    {items.map((item, index) => (
      <li>
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary-600 hover:underline"
          data-i18n={`${keyPrefix}.items.${index}.label`}
        >{item.label}</a>
      </li>
    ))}
  </ul>
</section>
