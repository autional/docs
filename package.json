{
  "name": "@autional/docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "gen-static": "node scripts/gen-static.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "prebuild": "node scripts/gen-static.mjs && node scripts/check-i18n.mjs && node scripts/gen-errors-contract.mjs --check && node scripts/gen-errors-pages.mjs",
    "predev": "node scripts/gen-static.mjs && node scripts/check-i18n.mjs && node scripts/gen-errors-contract.mjs --check && node scripts/gen-errors-pages.mjs",
    "dev": "astro dev --port 4432",
    "build": "astro build",
    "check-layers": "node scripts/check-layers.mjs",
    "postbuild": "node scripts/check-layers.mjs",
    "preview": "astro preview --port 4432",
    "gen:errors": "node scripts/gen-errors-contract.mjs && node scripts/gen-errors-pages.mjs",
    "gen:errors:check": "node scripts/gen-errors-contract.mjs --check"
  },
  "dependencies": {
    "@autional/tailwind-preset": "0.1.0-rc.10",
    "@autional/tokens": "0.1.0-rc.16",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.8.3"
  }
}
