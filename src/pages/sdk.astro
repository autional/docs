---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';
import { SITE_ROOT_DOMAIN, GITHUB_ORG_URL } from '../lib/site-env';

const reactCode = `import { AutionalProvider } from '@autional/react';

const config = { appId: 'my-app', issuer: 'https://api.${SITE_ROOT_DOMAIN}' };

function App() {
  return (
    <AutionalProvider config={config}>
      <YourApp />
    </AutionalProvider>
  );
}`;
const packages = t('sdk.packages.items', { returnObjects: true }) as { name: string; desc: string }[];
const catalog = t('sdk.catalog', { returnObjects: true }) as {
  before: string;
  mid: string;
  after: string;
  orgLink: string;
};
const sdkCatalogUrl = `https://www.${SITE_ROOT_DOMAIN}/sdk`;
---
<DocLayout title={t('sdk.meta.title')} description={t('sdk.meta.description')}>
  <h1 class="text-3xl font-bold mb-6" data-i18n="sdk.title">{t('sdk.title')}</h1>
  <p class="mb-6 text-neutral-600 dark:text-neutral-300"><span data-i18n="sdk.lead.before">{t('sdk.lead.before')}</span><code class="bg-neutral-100 px-1 rounded-xs">@autional</code><span data-i18n="sdk.lead.mid">{t('sdk.lead.mid')}</span></p>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="sdk.react.title">{t('sdk.react.title')}</h2>
  <pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6">npm install @autional/react</pre>
  <p class="mb-4 text-neutral-600" data-i18n="sdk.react.lead">{t('sdk.react.lead')}</p>
  <pre class="rounded-xl bg-code p-4 text-sm overflow-x-auto mb-6"><code>{reactCode}</code></pre>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="sdk.onboarding.title">{t('sdk.onboarding.title')}</h2>
  <p class="mb-4 text-neutral-600" data-i18n="sdk.onboarding.lead">{t('sdk.onboarding.lead')}</p>
  <pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6">npx @autional/onboard</pre>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="sdk.packages.title">{t('sdk.packages.title')}</h2>
  <table class="w-full text-sm mb-6 border-collapse">
    <thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2 px-2" data-i18n="sdk.packages.name">{t('sdk.packages.name')}</th><th class="text-left font-medium py-2 px-2" data-i18n="sdk.packages.description">{t('sdk.packages.description')}</th></tr></thead>
    <tbody>
      {packages.map((pkg, index) => <tr class="border-b border-neutral-100"><td class="py-2 px-2 font-mono text-xs">{pkg.name}</td><td class="py-2 px-2" data-i18n={`sdk.packages.items.${index}.desc`}>{pkg.desc}</td></tr>)}
    </tbody>
  </table>
  <p class="mb-4 text-neutral-600"><span data-i18n="sdk.catalog.before">{catalog.before}</span><a href={sdkCatalogUrl} class="text-primary-600 underline">{`www.${SITE_ROOT_DOMAIN}/sdk`}</a><span data-i18n="sdk.catalog.mid">{catalog.mid}</span><a href={GITHUB_ORG_URL} class="text-primary-600 underline" data-i18n="sdk.catalog.orgLink">{catalog.orgLink}</a><span data-i18n="sdk.catalog.after">{catalog.after}</span></p>
</DocLayout>
