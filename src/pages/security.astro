---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

const mfa = t('security.mfa', { returnObjects: true }) as {
  title: string;
  lead: string;
  method: string;
  phishing: string;
  setup: string;
  rows: { method: string; phishing: string; setup: string }[];
};
const adaptive = t('security.adaptive', { returnObjects: true }) as {
  title: string;
  lead: string;
  items: { label: string; body: string }[];
};
const policyItems = t('security.policy.items', { returnObjects: true }) as string[];
---
<DocLayout title={t('security.meta.title')} description={t('security.meta.description')}>
<h1 class="text-3xl font-bold mb-6" data-i18n="security.title">{t('security.title')}</h1>
<p class="mb-6 text-neutral-600" data-i18n="security.lead">{t('security.lead')}</p>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="security.mfa.title">{mfa.title}</h2>
<p class="mb-4 text-neutral-600" data-i18n="security.mfa.lead">{mfa.lead}</p>
<table class="w-full text-sm mb-6 border-collapse"><thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2 px-2" data-i18n="security.mfa.method">{mfa.method}</th><th class="text-left font-medium py-2 px-2" data-i18n="security.mfa.phishing">{mfa.phishing}</th><th class="text-left font-medium py-2 px-2" data-i18n="security.mfa.setup">{mfa.setup}</th></tr></thead><tbody>
{mfa.rows.map((row, index) => <tr class="border-b border-neutral-100"><td class="py-2 px-2" data-i18n={`security.mfa.rows.${index}.method`}>{row.method}</td><td class="py-2 px-2" data-i18n={`security.mfa.rows.${index}.phishing`}>{row.phishing}</td><td class="py-2 px-2" data-i18n={`security.mfa.rows.${index}.setup`}>{row.setup}</td></tr>)}
</tbody></table>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="security.adaptive.title">{adaptive.title}</h2>
<p class="mb-4 text-neutral-600" data-i18n="security.adaptive.lead">{adaptive.lead}</p>
<ul class="list-disc pl-6 space-y-1 text-sm text-neutral-600 mb-6">
{adaptive.items.map((item, index) => <li><strong data-i18n={`security.adaptive.items.${index}.label`}>{item.label}</strong><span data-i18n={`security.adaptive.items.${index}.body`}>{item.body}</span></li>)}
</ul>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="security.policy.title">{t('security.policy.title')}</h2>
<p class="mb-4 text-neutral-600" data-i18n="security.policy.lead">{t('security.policy.lead')}</p>
<ul class="list-disc pl-6 space-y-1 text-sm text-neutral-600 mb-6">
{policyItems.map((item, index) => <li data-i18n={`security.policy.items.${index}`}>{item}</li>)}
</ul>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="security.encryption.title">{t('security.encryption.title')}</h2>
<p class="mb-4 text-neutral-600" data-i18n="security.encryption.body">{t('security.encryption.body')}</p>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="security.audit.title">{t('security.audit.title')}</h2>
<p class="mb-4 text-neutral-600" data-i18n="security.audit.body">{t('security.audit.body')}</p>
</DocLayout>
