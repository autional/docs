---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

const config = t('deployment.config', { returnObjects: true }) as {
  title: string;
  lead: string;
  variable: string;
  description: string;
  required: string;
  rows: { name: string; desc: string }[];
};
const tls = t('deployment.tls', { returnObjects: true }) as { title: string; before: string; after: string };
---
<DocLayout title={t('deployment.meta.title')} description={t('deployment.meta.description')}>
  <h1 class="text-3xl font-bold mb-6" data-i18n="deployment.title">{t('deployment.title')}</h1>
  <p class="mb-6 text-neutral-600 dark:text-neutral-300" data-i18n="deployment.lead">{t('deployment.lead')}</p>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="deployment.compose.title">{t('deployment.compose.title')}</h2>
  <pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6" data-i18n="deployment.compose.code">{t('deployment.compose.code')}</pre>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="deployment.config.title">{config.title}</h2>
  <p class="mb-4 text-neutral-600" data-i18n="deployment.config.lead">{config.lead}</p>
  <table class="w-full text-sm mb-6 border-collapse">
    <thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2" data-i18n="deployment.config.variable">{config.variable}</th><th class="text-left font-medium py-2" data-i18n="deployment.config.description">{config.description}</th><th class="text-left font-medium py-2" data-i18n="deployment.config.required">{config.required}</th></tr></thead>
    <tbody>
      {config.rows.map((row, index) => (
        <tr class="border-b border-neutral-100"><td class="py-2 font-mono">{row.name}</td><td class="py-2" data-i18n={`deployment.config.rows.${index}.desc`}>{row.desc}</td><td class="py-2 text-success-text" data-i18n="common.yes">{t('common.yes')}</td></tr>
      ))}
    </tbody>
  </table>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="deployment.tls.title">{tls.title}</h2>
  <p class="mb-4 text-neutral-600"><span data-i18n="deployment.tls.before">{tls.before}</span><code class="bg-neutral-100 px-1 rounded-xs">docker/nginx/certs/</code><span data-i18n="deployment.tls.after">{tls.after}</span></p>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="deployment.monitoring.title">{t('deployment.monitoring.title')}</h2>
  <p class="mb-4 text-neutral-600" data-i18n="deployment.monitoring.lead">{t('deployment.monitoring.lead')}</p>
  <pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6" data-i18n="deployment.monitoring.code">{t('deployment.monitoring.code')}</pre>
</DocLayout>
