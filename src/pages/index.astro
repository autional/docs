---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

const steps = t('index.steps', { returnObjects: true }) as { title: string; body: string; command: string }[];
const links = t('index.links', { returnObjects: true }) as { label: string; href: string; description: string }[];
---
<DocLayout title={t('index.meta.title')} description={t('index.meta.description')}>
  <span class="brand-kicker" data-i18n="index.kicker">{t('index.kicker')}</span>
  <h1 class="mt-5" data-i18n="index.title">{t('index.title')}</h1>
  <p data-i18n="index.lead">
    {t('index.lead')}
  </p>

  <div class="mt-8 grid gap-5 xl:grid-cols-3">
    {steps.map((step, index) => (
      <section class="brand-card px-6 py-6">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-700 text-sm font-bold text-white">{index + 1}</span>
          <h2 class="mt-0 text-xl font-semibold text-primary-900" data-i18n={`index.steps.${index}.title`}>{step.title}</h2>
        </div>
        <p class="mt-4" data-i18n={`index.steps.${index}.body`}>{step.body}</p>
        <pre data-i18n={`index.steps.${index}.command`}>{step.command}</pre>
      </section>
    ))}
  </div>

  <h2 data-i18n="index.nextTitle">{t('index.nextTitle')}</h2>
  <div class="mt-5 grid gap-4 md:grid-cols-2">
    {links.map((link, index) => (
      <a href={link.href} class="brand-card block px-6 py-5 no-underline">
        <div class="text-lg font-semibold text-primary-900" data-i18n={`index.links.${index}.label`}>{link.label}</div>
        <p class="mt-2 text-sm leading-7 text-neutral-600" data-i18n={`index.links.${index}.description`}>{link.description}</p>
      </a>
    ))}
  </div>
</DocLayout>
