---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';
import { brotherUrl } from '../lib/site-env';

const referenceUrl = `${brotherUrl('reference')}/`;
const specBase = `${brotherUrl('reference')}/specs`;
---
<DocLayout title={t('api.meta.title')} description={t('api.meta.description')}>
  <h1 class="text-3xl font-bold mb-6" data-i18n="api.title">{t('api.title')}</h1>
  <p class="mb-6 text-neutral-600 dark:text-neutral-300" data-i18n="api.lead">{t('api.lead')}</p>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="api.interactiveTitle">{t('api.interactiveTitle')}</h2>
  <pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6">{referenceUrl}</pre>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="api.endpoints.title">{t('api.endpoints.title')}</h2>
  <table class="w-full text-sm mt-4 border-collapse">
    <thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2" data-i18n="api.endpoints.service">{t('api.endpoints.service')}</th><th class="text-left font-medium py-2" data-i18n="api.endpoints.port">{t('api.endpoints.port')}</th><th class="text-left font-medium py-2" data-i18n="api.endpoints.basePath">{t('api.endpoints.basePath')}</th></tr></thead>
    <tbody>
      <tr class="border-b border-neutral-100"><td class="py-2">Gateway</td><td class="py-2 font-mono">11080</td><td class="py-2 font-mono">/bff/&#123;service&#125;/api/v1/</td></tr>
      <tr class="border-b border-neutral-100"><td class="py-2">Identity</td><td class="py-2 font-mono">11001</td><td class="py-2 font-mono">/api/v1/auth/</td></tr>
      <tr class="border-b border-neutral-100"><td class="py-2">MFA</td><td class="py-2 font-mono">11005</td><td class="py-2 font-mono">/api/v1/mfa/</td></tr>
      <tr class="border-b border-neutral-100"><td class="py-2">OAuth</td><td class="py-2 font-mono">11006</td><td class="py-2 font-mono">/oauth/</td></tr>
      <tr class="border-b border-neutral-100"><td class="py-2">Tenant</td><td class="py-2 font-mono">11003</td><td class="py-2 font-mono">/api/v1/tenants/</td></tr>
      <tr class="border-b border-neutral-100"><td class="py-2">Session</td><td class="py-2 font-mono">11004</td><td class="py-2 font-mono">/api/v1/sessions/</td></tr>
      <tr class="border-b border-neutral-100"><td class="py-2">Audit</td><td class="py-2 font-mono">11013</td><td class="py-2 font-mono">/api/v1/admin/audit/</td></tr>
      <tr><td class="py-2">RBAC</td><td class="py-2 font-mono">11025</td><td class="py-2 font-mono">/api/v1/admin/roles</td></tr>
    </tbody>
  </table>
  <h2 class="text-xl font-bold mt-8 mb-3" data-i18n="api.spec.title">{t('api.spec.title')}</h2>
  <p class="mb-4 text-neutral-600" data-i18n="api.spec.lead">{t('api.spec.lead')}</p>
  <pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto">{`${specBase}/{service}.json`}

<span data-i18n="api.spec.exampleComment">{t('api.spec.exampleComment')}</span>
{`${specBase}/identity-service.json`}</pre>
</DocLayout>
