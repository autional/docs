---
import DocLayout from '../layouts/DocLayout.astro';
import { t } from '../i18n';

const modes = t('authConcepts.modes', { returnObjects: true }) as {
  title: string;
  lead: string;
  mode: string;
  security: string;
  useCase: string;
  rows: { mode: string; security: string; useCase: string }[];
};
const hashing = t('authConcepts.hashing', { returnObjects: true }) as {
  title: string;
  before: string;
  mid: string;
  after: string;
};
const oauthItems = t('authConcepts.oauth.items', { returnObjects: true }) as string[];
---
<DocLayout title={t('authConcepts.meta.title')} description={t('authConcepts.meta.description')}>
<h1 class="text-3xl font-bold mb-6" data-i18n="authConcepts.title">{t('authConcepts.title')}</h1>
<p class="mb-6 text-neutral-600" data-i18n="authConcepts.lead">{t('authConcepts.lead')}</p>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="authConcepts.modes.title">{modes.title}</h2>
<p class="mb-4 text-neutral-600" data-i18n="authConcepts.modes.lead">{modes.lead}</p>
<table class="w-full text-sm mb-6 border-collapse"><thead><tr class="border-b border-neutral-200"><th class="text-left font-medium py-2 px-2" data-i18n="authConcepts.modes.mode">{modes.mode}</th><th class="text-left font-medium py-2 px-2" data-i18n="authConcepts.modes.security">{modes.security}</th><th class="text-left font-medium py-2 px-2" data-i18n="authConcepts.modes.useCase">{modes.useCase}</th></tr></thead><tbody>
{modes.rows.map((row, index) => <tr class="border-b border-neutral-100"><td class="py-2 px-2 font-mono">{row.mode}</td><td class="py-2 px-2" data-i18n={`authConcepts.modes.rows.${index}.security`}>{row.security}</td><td class="py-2 px-2" data-i18n={`authConcepts.modes.rows.${index}.useCase`}>{row.useCase}</td></tr>)}
</tbody></table>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="authConcepts.hashing.title">{hashing.title}</h2>
<p class="mb-4 text-neutral-600"><span data-i18n="authConcepts.hashing.before">{hashing.before}</span><strong>argon2id</strong><span data-i18n="authConcepts.hashing.mid">{hashing.mid}</span><strong>PASSWORD_PEPPER</strong><span data-i18n="authConcepts.hashing.after">{hashing.after}</span></p>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="authConcepts.session.title">{t('authConcepts.session.title')}</h2>
<pre class="rounded-xl bg-code text-syntax-plain p-4 text-sm overflow-x-auto mb-6">User Login → POST /auth/login
  ├─ Returns: access_token (JWT, 5min) + refresh_token (24h)
  ├─ Access token: sent as Authorization Bearer header
  ├─ Refresh: POST /auth/refresh → new token pair
  └─ Logout: POST /auth/logout → revoke tokens, blacklist</pre>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="authConcepts.oauth.title">{t('authConcepts.oauth.title')}</h2>
<p class="mb-4 text-neutral-600" data-i18n="authConcepts.oauth.lead">{t('authConcepts.oauth.lead')}</p>
<ul class="list-disc pl-6 space-y-1 text-sm text-neutral-600 mb-6">
{oauthItems.map((item, index) => <li data-i18n={`authConcepts.oauth.items.${index}`}>{item}</li>)}
</ul>
<h2 class="text-xl font-bold mb-3 mt-8" data-i18n="authConcepts.saml.title">{t('authConcepts.saml.title')}</h2>
<p class="mb-4 text-neutral-600" data-i18n="authConcepts.saml.body">{t('authConcepts.saml.body')}</p>
</DocLayout>
